# Copie este arquivo para ".env" e ajuste os valores conforme seu ambiente.

SECRET_KEY=qwertyuiopasdfghjklzxcvbnm1234567890
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# HTTPS em produção (DEBUG=False) - necessário pro Service Worker do PWA
# funcionar (instalação, offline). SECURE_SSL_REDIRECT=False só se o site
# ainda não tiver certificado HTTPS configurado (não recomendado). Ligue
# ATRAS_DE_PROXY_HTTPS=True somente se houver um proxy/load balancer
# confiável (Nginx, Cloudflare) na frente do Django terminando o HTTPS -
# nunca com o Django exposto direto à internet.
SECURE_SSL_REDIRECT=True
ATRAS_DE_PROXY_HTTPS=False

# Banco de dados PostgreSQL
DB_NAME=bolsatrader
DB_USER=postgres
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5432

# API de cotações (brapi.dev) - token opcional, aumenta o limite de requisições.
# Crie uma conta gratuita em https://brapi.dev para obter um token, se desejar.
BRAPI_BASE_URL=https://brapi.dev/api
BRAPI_TOKEN=

# Máximo de tickers por requisição em lote de cotações - depende do PLANO
# contratado na brapi.dev (gratuito/Startup = 10, Pro = 20). Ajuste aqui se
# mudar de plano - pedir mais que o limite não dá 429, dá 400
# "QUOTES_PER_REQUEST_EXCEEDED" e o lote inteiro falha.
BRAPI_TICKERS_POR_LOTE=10

# Orçamento de requisições da brapi.dev por ciclo de 30 dias (Startup = 150000).
# O sistema conta cada requisição: o ciclo AUTOMÁTICO pausa ao chegar em
# LIMITE x (100 - MARGEM)% e NENHUMA requisição é feita acima de 95% do limite.
BRAPI_LIMITE_MENSAL=150000
BRAPI_MARGEM_SEGURANCA_PCT=30

# De quantos em quantos minutos as cotações são buscadas de novo sozinhas -
# pelo agendador embutido no próprio processo do servidor (não afeta o botão
# manual "Atualizar cotações agora" do site, que é sempre na hora).
COTACOES_INTERVALO_MINUTOS=60

# Liga (True, padrão) o agendador embutido de cotações - uma thread que roda
# junto com o próprio servidor web e atualiza sozinha a cada
# COTACOES_INTERVALO_MINUTOS minutos, sem precisar de um processo separado.
# Desligue (False) só se rodar mais de um worker atrás do mesmo servidor
# (ex: gunicorn --workers > 1), pra não duplicar o trabalho - nesse caso use
# "python manage.py atualizar_cotacoes --loop" à parte, em um processo único.
AGENDADOR_COTACOES_EMBUTIDO=True

# Metas padrão de lucro/perda (%) usadas quando a operação não define uma meta própria
META_LUCRO_PADRAO=5.0
META_PERDA_PADRAO=-5.0

# Quantidade máxima de ativos DIFERENTES que cada usuário pode ter comprados
# (em carteira) ao mesmo tempo - não conta reservas nem limita a quantidade
# de ações dentro de um ativo já comprado, só o número de tickers distintos.
# Acima do limite, o sistema recusa comprar (ou efetivar reserva de) um ativo
# novo, com uma mensagem avisando que a cota foi atingida.
MAX_ATIVOS_EM_CARTEIRA=10

# De quantos em quantos minutos o comando "atualizar_noticias --loop" busca as
# manchetes de novo (não afeta o botão manual "Atualizar notícias agora" do
# site). Padrão: 1440 min (24h) - as fontes de notícias são configuráveis em
# Notícias do Mercado, não fixas aqui.
NOTICIAS_INTERVALO_MINUTOS=1440

# URL padrão do campo "abrir no TradingView" da tela TradingView (o usuário
# pode digitar/colar outra URL na hora - este é só o valor pré-preenchido).
TRADINGVIEW_URL_PESQUISA=https://br.tradingview.com/markets/stocks-brazil/market-movers-all-stocks/

# Horário de negociação da B3 (formato HH:MM) - mostrado em destaque no Painel
# de Controle, Posições em Carteira e Minhas Operações.
B3_HORARIO_ABERTURA=10:00
B3_HORARIO_FECHAMENTO=17:00

# WhatsApp: número do ícone de contato + webhook opcional (Meta Cloud API) para
# receber mensagens automaticamente. Ver core/views.py:whatsapp_webhook.
WHATSAPP_NUMERO=5565981132995
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
